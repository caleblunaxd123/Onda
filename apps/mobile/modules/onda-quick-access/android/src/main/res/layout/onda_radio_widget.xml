<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/onda_widget_root"
  android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
  android:padding="14dp" android:background="@drawable/onda_widget_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="ONDA" android:textSize="22sp" android:textStyle="bold" android:textColor="#40DCF2"/>
    <TextView android:id="@+id/onda_widget_library" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:text="Mi biblioteca  ›" android:textSize="12sp" android:textColor="#E2E8FF" android:contentDescription="Abrir biblioteca de ONDA"/>
  </LinearLayout>
  <TextView android:id="@+id/onda_widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:text="Tus favoritas, a un toque" android:textColor="#B8C8EA" android:textSize="12sp" android:layout_marginBottom="8dp"/>
  <TextView android:id="@+id/onda_widget_favorite_0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="36dp" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:singleLine="true" android:ellipsize="end" android:text="♡ Guarda tus radios favoritas" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/onda_widget_row"/>
  <TextView android:id="@+id/onda_widget_favorite_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="36dp" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:layout_marginTop="5dp" android:singleLine="true" android:ellipsize="end" android:text="Explora el mundo" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/onda_widget_row"/>
  <TextView android:id="@+id/onda_widget_favorite_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="36dp" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:layout_marginTop="5dp" android:singleLine="true" android:ellipsize="end" android:text="Encuentra tu próxima favorita" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/onda_widget_row"/>
</LinearLayout>
